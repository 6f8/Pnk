<Project Sdk="Microsoft.NET.Sdk">
  <!-- اختبارات محرك التحليل بدون واجهة: dotnet run من هذا المجلد -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Kashif.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- قاعدة بيانات حقيقية لاختبار الحفظ والفتح والتقارير (StoreSql) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Kashif\Core\Panic\*.cs" Link="Engine\%(Filename)%(Extension)" />
    <Compile Include="..\Kashif\Core\Device\*.cs" Link="Device\%(Filename)%(Extension)" />
    <Compile Include="..\Kashif\Core\Updates.cs" Link="Engine\Updates.cs" />
    <EmbeddedResource Include="..\Kashif\Data\knowledge.json" LogicalName="Kashif.knowledge.json" />
    <None Include="Samples\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
