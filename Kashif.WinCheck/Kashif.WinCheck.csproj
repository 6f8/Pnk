<Project Sdk="Microsoft.NET.Sdk">
  <!-- فحوصات تحتاج ويندوز (قارئ النصوص في الصور): تعمل في GitHub Actions على windows-latest -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Kashif.WinCheck</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Kashif\Core\Panic\*.cs" Link="Engine\%(Filename)%(Extension)" />
    <Compile Include="..\Kashif\Core\ImageText.cs" Link="Engine\ImageText.cs" />
    <Compile Include="..\Kashif\Core\ReportImage.cs" Link="Engine\ReportImage.cs" />
    <EmbeddedResource Include="..\Kashif\Data\knowledge.json" LogicalName="Kashif.knowledge.json" />
    <None Include="..\Kashif.Tests\Samples\prs0_iphone11_ocr.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Kashif.Tests\Samples\smc_bsc_d64_screen_sensor.ips" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
